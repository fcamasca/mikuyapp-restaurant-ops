{
  "name": "mikuyapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:auth": "node --experimental-strip-types --test tests/authSession.test.mjs",
    "test:profile": "node --experimental-strip-types --test tests/profileContext.test.mjs",
    "test:routes": "node --experimental-strip-types --test tests/appRoutes.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:anon": "node --env-file=.env.local scripts/verifyAnonAccess.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
