VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Metadatos públicos/no secretos usados por la guardia de ambientes.
# Local usa LEGACY_SHARED + DEV y obtiene el ref esperado del vínculo local
# de Supabase CLI si estos refs quedan vacíos.
MIKUY_ENVIRONMENT_STATE=LEGACY_SHARED
MIKUY_LOGICAL_ENVIRONMENT=DEV
MIKUY_EXPECTED_SUPABASE_PROJECT_REF=
MIKUY_DEV_SUPABASE_PROJECT_REF=
MIKUY_SHARED_SUPABASE_PROJECT_REF=
MIKUY_PROD_SUPABASE_PROJECT_REF=
MIKUY_PRODUCTION_BRANCH=main

# Nunca agregar aquí service_role, access tokens, contraseñas de base,
# secretos JWT/SMTP ni otras credenciales administrativas. Ningún secreto
# administrativo debe usar el prefijo VITE_.
